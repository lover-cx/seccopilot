# SecCopilot 环境变量配置
# 复制此文件为 .env 并填写你的密钥。.env 不要提交到任何版本库。

# DashScope（通义千问）密钥：向量嵌入 text-embedding-v3 + 生成 qwen-flash/qwen-plus + 联网检索
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Supabase 配置（project ref 与 publishable key 按你自己的项目填写）
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_publishable_key_here

# NVD API Key（可选，提高速率限制）
# NVD_API_KEY=your_nvd_api_key_here

# 本地代理：Supabase 需经代理时填写；DashScope 直连，不要走代理
# HTTP_PROXY=http://127.0.0.1:7897

# 说明：部署到 Qoder Sites 时，密钥名要写成 APP_SUPABASE_URL / APP_SUPABASE_ANON_KEY，
# 因为 SUPABASE_、POSTGRES_、QODER_ 前缀与 DATABASE_URL 是平台保留名。
# 本地脚本读的是本文件里的 SUPABASE_URL / SUPABASE_KEY，两套命名不要混用。
